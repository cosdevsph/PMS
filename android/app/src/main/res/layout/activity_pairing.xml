<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarPairing"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="@string/title_pairing"
            app:titleTextColor="#FFFFFF" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Camera Scanner Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardScannerContainer"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- ZXing BarcodeView -->
                <com.journeyapps.barcodescanner.CompoundBarcodeView
                    android:id="@+id/barcodeScannerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Scan Guidance Overlay -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="#B3000000"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="Align QR Code on Web Dashboard"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <!-- Flashlight Toggle -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleTorch"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:backgroundTint="#80000000"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconTint="#FFFFFF" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Detected SIM Card Banner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="10dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIM:"
                    android:textColor="#0D9488"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetectedSims"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Detecting inserted SIM..."
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Manual Pairing / Credentials Form -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Or Enter Code Manually"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- 8-char Pairing Code -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPairingCode"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Pairing Code (e.g. MAL-AB12)"
                    android:textColorHint="#94A3B8"
                    app:boxStrokeColor="#0D9488"
                    app:hintTextColor="#0D9488">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPairingCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:hint="@string/hint_pairing_code"
                        android:inputType="textCapCharacters"
                        android:maxLength="10"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Server API URL -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilServerUrl"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Malasakit Server URL"
                    android:textColorHint="#94A3B8"
                    app:boxStrokeColor="#0D9488"
                    app:hintTextColor="#0D9488">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_server_url"
                        android:inputType="textUri"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Device Custom Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDeviceName"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Device Label (e.g. Front Desk Phone)"
                    android:textColorHint="#94A3B8"
                    app:boxStrokeColor="#0D9488"
                    app:hintTextColor="#0D9488">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDeviceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Error Message Display -->
                <TextView
                    android:id="@+id/tvPairingError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#EF4444"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Pairing failed: Session expired" />

                <!-- Progress Bar -->
                <LinearLayout
                    android:id="@+id/layoutLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:indeterminateTint="#0D9488" />

                    <TextView
                        android:id="@+id/tvLoadingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Connecting to clinic..."
                        android:textColor="#0D9488"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Submit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitPairing"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="24dp"
                    android:backgroundTint="#0D9488"
                    android:text="Connect &amp; Pair Device"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
